{
  "name": "@kailashe/cli",
  "version": "0.1.0",
  "description": "Kailashe CLI",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "kailashe": "./bin/kailashe.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@kailashe/core": "workspace:*",
    "@kailashe/plan": "workspace:*",
    "commander": "12.1.0",
    "@clack/prompts": "0.10.1",
    "yaml": "2.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2",
    "vitest": "3.1.4"
  }
}
